# Backend environment template. Copy to backend/.env for local testing.
# Put real secrets only in the backend host's secret settings.
APP_ENV=development
DEBUG=false
APP_VERSION=1.0.0
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173

BUSINESS_ID=replace-with-business-record-id
BUSINESS_NAME=Waltain Energy Private Limited
BUSINESS_WEBSITE_URL=https://waltainenergy.com
# Public addresses shown on the site, chatbot, and emails; first two are highlighted.
BUSINESS_PUBLIC_EMAIL=jalpan@waltainenergy.com,mailus@waltainenergy.com,connect.waltainenergy@gmail.com
BUSINESS_PUBLIC_PHONE=+91 99982 33956
# Internal inbox that receives new website inquiries and chat follow-up alerts.
BUSINESS_NOTIFICATION_EMAIL=connect.waltainenergy@gmail.com

DATABASE_URL="postgresql+asyncpg://neondb_owner:npg_sTcP1OxBDH2K@ep-frosty-dream-b5dy35hh-pooler.c-7.us-east-2.aws.neon.tech/neondb?ssl=require"

# Optional for the chatbot's LLM responses; grounded FAQ fallback works without it.
# Groq uses its OpenAI-compatible API. Set LLM_API_KEY to the Groq API key.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# For Gemini instead, set LLM_PROVIDER=gemini and LLM_MODEL=gemini-2.0-flash.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.2

# Chat session and lead reminder behavior
SESSION_COOKIE_NAME=we_chat_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TOKEN_TTL_SECONDS=3600
CHAT_SESSION_TTL_SECONDS=3600
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_MESSAGE_LENGTH=4000
LEAD_CAPTURE_ENABLED=true

# SMTP: required for chat lead and contact form email notifications.
# Use an email-provider-verified sender address. Do not use visitor email as From.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=Waltain Energy Notifications
EMAIL_REPLY_TO_ENABLED=true
EMAIL_TIMEOUT_SECONDS=20
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
